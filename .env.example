# ============================================
# JOLT Website — environment configuration
# Copy to .env.local and fill in real values.
# NEVER commit real secrets.
# ============================================

# JOLT backend API (external)
JOLT_API_BASE_URL=https://api.example.com/v1
JOLT_API_KEY=your_api_key_here

# Mock mode: serve deterministic stub responses, no external calls.
# Set to "false" once the real backend is available.
JOLT_API_MOCK=true
